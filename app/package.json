{
  "name": "crystalfield-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/verify-prerender-seo.mjs",
    "build:maya-test": "vite build --config vite.maya-test.config.ts --mode maya-test",
    "check:maya-environment": "node scripts/maya-environment-check.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:production": "node scripts/smoke-test.mjs",
    "seo:verify": "node scripts/verify-prerender-seo.mjs",
    "seo:http:verify": "node scripts/verify-production-seo-http.mjs",
    "test:hydration": "node scripts/hydration-check.mjs",
    "test:auth": "tsx scripts/auth-flow-check.ts",
    "test:payment-return": "tsx scripts/checkout-return-check.ts",
    "test:ga4": "tsx scripts/ga4-event-check.ts",
    "test:vedic-progress": "tsx scripts/vedic-progress-check.ts",
    "test:vedic-locale": "tsx scripts/vedic-locale-check.ts",
    "test:tarot-deep-analysis": "tsx scripts/tarot-deep-analysis-check.ts",
    "test:dreamspell": "tsx --test src/lib/dreamspell.test.ts",
    "test:maya-routes": "tsx scripts/maya-route-check.ts",
    "test:maya-browser": "tsx scripts/maya-browser-check.ts",
    "test:maya-admin-preview-ui": "tsx scripts/maya-admin-preview-ui-check.ts",
    "test:maya-public-smoke": "tsx scripts/maya-public-smoke.ts",
    "test:maya-external-e2e": "tsx scripts/maya-external-e2e.ts",
    "test:maya-references": "tsx --test scripts/maya-reference-check.ts",
    "test:maya-visualization": "tsx --test scripts/maya-visualization-check.ts",
    "test:maya-visualization-browser": "tsx scripts/maya-visualization-browser-check.ts",
    "test:maya-pro-browser": "tsx scripts/maya-pro-browser-check.ts",
    "test:maya-premium-live-browser": "tsx scripts/maya-premium-live-browser-check.ts",
    "test:maya-unlock-browser": "tsx scripts/maya-unlock-browser-check.ts",
    "typecheck:maya-acceptance": "tsc --noEmit -p tsconfig.maya-acceptance.json",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "@eslint/js": "^9.9.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
